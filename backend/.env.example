# ==============================================================================
# IP-SAKTI Sahayak - Environment Configuration Template
# Copy this to .env and fill in your actual values.
# ==============================================================================

PROJECT_NAME="IP-SAKTI Sahayak"
VERSION="1.0.0"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# --- AI & LLM Services ---
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_FAST_MODEL="qwen/qwen3.8-27b"
OPENAI_API_KEY=""
BHASHINI_API_KEY=""

# --- Embeddings & Vector Search (Aligned with Admin Ingestion) ---
EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"
EMBEDDING_DIMENSION=384
EMBEDDING_METRIC="Cosine"
QDRANT_COLLECTION_NAME="legal_chunks"

# --- Vector Database (Qdrant Cloud / Local) ---
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
LOCAL_QDRANT_PATH=""

# --- Knowledge Graph (Neo4j) ---
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASS="your-neo4j-password"

# --- Celery & Redis Task Queue ---
REDIS_URL="redis://localhost:6379/0"

# --- Data Sources ---
RAW_DATA_DRIVE_URL=""
