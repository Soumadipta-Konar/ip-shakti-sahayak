# ==============================================================================
# IP-SAKTI Sahayak (Frontend Modern) - Environment Configuration
# ==============================================================================

# 1. Local Development:
# Run backend locally on port 8000 and frontend on port 3001
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# 2. Vercel Production Deployment:
# Set this in your Vercel Project Settings > Environment Variables:
# Replace with your actual Render service URL (ending with /api/v1):
# NEXT_PUBLIC_API_URL=https://ip-sakti-sahayak-backend.onrender.com/api/v1
